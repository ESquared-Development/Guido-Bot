NODE_ENV=development
LOG_LEVEL=debug

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
CITY_GUIDE_CHANNEL_ID=
STAFF_ROLE_ID=

OPENAI_API_KEY=
